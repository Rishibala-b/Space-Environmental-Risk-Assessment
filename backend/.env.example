# Copy this file to ".env" and fill in real values.
# NEVER put real credentials in this file -- it is meant to be shared/committed.
# The real ".env" is listed in .gitignore.

# --- Space-Track.org credentials (REQUIRED) ---
# Every agent queries Space-Track live; there is no local dataset.
SPACETRACK_USERNAME=your_spacetrack_email_id_here
SPACETRACK_PASSWORD=your_spacetrack_password_here

# --- Space-Track usage policy (defaults stay under 30/min and 300/hour) ---
SPACETRACK_MAX_PER_MINUTE=25
SPACETRACK_MAX_PER_HOUR=280
SPACETRACK_MAX_WAIT_SECONDS=15
SPACETRACK_TIMEOUT_SECONDS=20

# --- Batch / fleet analysis ---
BATCH_MAX_OBJECTS=500
BATCH_IDS_PER_REQUEST=100
BATCH_MAX_WORKERS=3

# --- Classification model ---
CLASSIFICATION_MODEL_PATH=./data/gradient_boosting_model.pkl

# --- LLM configuration ---
# none      -> built-in rule-based fallback, no key needed
# anthropic -> Anthropic API (e.g. LLM_MODEL=claude-sonnet-4-5)
# google    -> Gemini via google-genai (e.g. LLM_MODEL=gemini-2.5-flash)
LLM_PROVIDER=google
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash

# --- CORS (for the React/Vite frontend) ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
